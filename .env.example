OPENAI_API_KEY="replace-with-your-provider-api-key"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_RESEARCH_MODEL=deepseek-flash
# Native web-search support is model/account dependent and must be capability-
# probed. Keep it off for deterministic point-in-time research.
LONGVOL_ALLOW_NATIVE_WEB_SEARCH=false
# auto prefers direct Benzinga, then Alpaca News, then Massive; SEC is added
# when SEC_USER_AGENT is present. Comma-separated explicit values are allowed.
LONGVOL_NEWS_PROVIDERS=auto
# Keep false until the vendor/account confirms complete real-time coverage.
ALPACA_NEWS_REALTIME_ENTITLED=false
BENZINGA_NEWS_REALTIME_ENTITLED=false
BENZINGA_API_KEY=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
MASSIVE_API_KEY=
# SEC fair-access policy requires an identifiable application/contact string.
SEC_USER_AGENT=
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
LOCAL_UID=1000
LOCAL_GID=1000
# Required only for REAL order submission. Store the MD5 value, never plaintext.
MOOMOO_TRADE_PASSWORD_MD5=
